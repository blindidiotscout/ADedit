#include "windows.h"
#include "hie_mmc_plugin.h"

#define IDD_HIEQUOTA_DIALOG 1001

IDD_HIEQUOTA_DIALOG DIALOGEX 0, 0, 260, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HIE Quota Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    // HIE Attribute (Editierbar)
    LTEXT           "HIE Send Quota (KB):", IDC_STATIC, 10, 10, 100, 8
    EDITTEXT        IDT_QUOTA_SEND, 120, 10, 120, 14
    
    LTEXT           "HIE Receive Quota (KB):", IDC_STATIC, 10, 30, 100, 8
    EDITTEXT        IDT_QUOTA_RECEIVE, 120, 30, 120, 14
    
    LTEXT           "HIE Storage Limit (KB):", IDC_STATIC, 10, 50, 100, 8
    EDITTEXT        IDT_QUOTA_STORAGE, 120, 50, 120, 14

    // Exchange Aliase (Schreibgeschützt)
    GROUPBOX        "Exchange Aliase (Read-Only)", IDC_STATIC, 10, 80, 230, 70
    LTEXT           "mDBOverQuotaLimit:", IDC_STATIC, 20, 95, 100, 8
    EDITTEXT        IDT_EX_SEND, 130, 95, 100, 14, ES_READONLY
    
    LTEXT           "mDBOverHardQuotaLimit:", IDC_STATIC, 20, 115, 100, 8
    EDITTEXT        IDT_EX_RECEIVE, 130, 115, 100, 14, ES_READONLY
    
    LTEXT           "mDBStorageQuota:", IDC_STATIC, 20, 135, 100, 8
    EDITTEXT        IDT_EX_STORAGE, 130, 135, 100, 14, ES_READONLY

    DEFPUSHBUTTON   "OK", IDOK, 100, 170, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 170, 50, 14
END
