dn: CN=HIE-Attributes,CN=Schema,CN=Configuration,DC=X
changetype: add
objectClass: container
description: Container für HIE Quota Attribute

dn: CN=HIEprohibitsendquota,CN=Schema,CN=Configuration,DC=X
changetype: add
objectClass: attributeSchema
lDAPDisplayName: HIEprohibitsendquota
attributeId: 1.3.6.1.4.1.65881.1.1.1.1
attributeSyntax: 2.5.5.9
oMSyntax: 10
isSingleValued: TRUE
description: Can't send mail limit (in KB)
adminDisplayName: HIEprohibitsendquota

dn: CN=HIEprohibitreceivequota,CN=Schema,CN=Configuration,DC=X
changetype: add
objectClass: attributeSchema
lDAPDisplayName: HIEprohibitreceivequota
attributeId: 1.3.6.1.4.1.65881.1.1.1.2
attributeSyntax: 2.5.5.9
oMSyntax: 10
isSingleValued: TRUE
description: Can't receive mails limit (in KB)
adminDisplayName: HIEprohibitreceivequota

dn: CN=HIEstoragequotalimit,CN=Schema,CN=Configuration,DC=X
changetype: add
objectClass: attributeSchema
lDAPDisplayName: HIEstoragequotalimit
attributeId: 1.3.6.1.4.1.65881.1.1.1.3
attributeSyntax: 2.5.5.9
oMSyntax: 10
isSingleValued: TRUE
description: Max mailbox size limit (in KB)
adminDisplayName: HIEstoragequotalimit

dn: CN=User,CN=Schema,CN=Configuration,DC=X
changetype: modify
add: mayContain
mayContain: HIEprohibitsendquota
-
add: mayContain
mayContain: HIEprohibitreceivequota
-
add: mayContain
mayContain: HIEstoragequotalimit
-

# Import-Befehl:
# ldifde -i -f hie-schema.ldf -c "DC=X" "DC=deinedomaene,DC=local"
# Hinweis: Ersetze "DC=deinedomaene,DC=local" mit dem echten Root-DN deiner AD-Domäne.

dn: 
changetype: modify
add: schemaUpdateNow
schemaUpdateNow: 1
-
