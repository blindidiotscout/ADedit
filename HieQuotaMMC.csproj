<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>HieQuotaMMC</RootNamespace>
    <AssemblyName>HieQuotaMMC</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- 
      WICHTIG: Microsoft.ManagementConsole.dll ist nicht auf NuGet verfügbar.
      Sie muss manuell als Referenz hinzugefügt werden.
      Pfad auf einem Windows System: C:\Windows\Microsoft.NET\Framework64\v4.0.30319\Microsoft.ManagementConsole.dll
    -->
    <Reference Include="Microsoft.ManagementConsole">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\Microsoft.ManagementConsole.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
